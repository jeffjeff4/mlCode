'''
Suppose we want to categorize reviews on Amazon products, and group reviews that are similar.
So, given two product reviews, let’s say ‘review1’ and ‘review2’, write a function that evaluates if these are similar.
Each review is a single sentence, and is a list of words. We denote each word as ‘review[x]’.
We say that ‘review1’ and ‘review2’ are similar if ‘review1[x]’ and ‘review2[x]’ are synonymous.

In this function, we are given ‘review1’ and ‘review2’, as well as a list of synonym pairs ’synonyms’.

# Example:

review1 = [“great”, “product”]
review2 = [“amazing”, “device”]
synonyms = [[“great”, “amazing”], [“product”, “device”]]

Result: True

'''

Class Finder:
    def __init__(self, synonyms):
        self.parent = {}
        self.rank = {}
        
        for w1, w2 in synonyms:
            self.union(w1, w2)
            
            
    def find(self, word):
        if word not in self.parent:
            self.parent[word] = word
            self.rank[word] = 0
            return word
            
        if self.parent[word] != word:
            self.parent[word] = self.find(self.parent[word])
            
        return self.parent[word]
    
    def union(self, w1, w2):
        root1 = self.find(w1)
        root2 = self.find(w2)
        
        if root1 != root2:
            if self.rank[root1] < self.rank[root2]:
                self.parent[root1] = root2
                self.rank[root2] += 1
            elif self.rank[root1] > self.rank[root2]:
                self.parent[root2] = root1
                self.rank[root1] += 1
            else:
                self.parent[root2] = root1
                self.rank[root1] += 1
                
            return True
            
        return False
        
        
    def are_synonyms(w1, w2):
        root1 = self.find(w1)
        root2 = self.find(w2)
        if root1 == root2:
            return True
            
        return False
        
                

class ReviewComparator:
    def __init__(self, synonyms):
        #sanity check
        if not isinstance(synonyms, list):
            raise TypeError("synonyms should be a list")
            
        self.synonyms_finder = Finder(synonyms)
        
        
    def are_review_similar(self, review1, review2):
        if len(review1) != len(review2):
            return False
            
        for w1, w2 in zip(review1, review2):
            if self.synonyms_finder.are_synonyms(w1, w2) == False:
                return False
                
        return True
        
        
        
