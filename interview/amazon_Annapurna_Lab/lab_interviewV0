"""
Implementation of a Cyclic Ring Buffer in Python.
"""

class CyclicRingBuffer:
    """
    A cyclic ring buffer of a fixed size.

    This data structure implements a first-in, first-out (FIFO) queue with a
    fixed capacity. When the buffer is full, newly written values will overwrite
    the oldest values in the buffer. When reading, the oldest value is returned
    and removed from the buffer.

    All operations (write, read) are performed in constant time.

    Attributes:
        capacity (int): The maximum number of elements the buffer can hold.
        buffer (list): The internal list used to store buffer elements.
        head (int): A pointer to the index of the oldest element (next to be read).
        tail (int): A pointer to the index of the next available slot for writing.
        size (int): The current number of valid elements in the buffer.

    Time Complexity:
        - Initialization: O(N) where N is the capacity, due to list pre-allocation.
        - Write: O(1)
        - Read: O(1)

    Space Complexity:
        - O(N) where N is the capacity, to store the buffer elements.
    """

    def __init__(self, capacity: int):
        """
        Initializes the ring buffer with a given capacity.

        Args:
            capacity: The maximum number of elements the buffer can hold.
                      Must be a positive integer.
        
        Raises:
            ValueError: If capacity is not a positive integer.
        """
        if not isinstance(capacity, int) or capacity <= 0:
            raise ValueError("Capacity must be a positive integer.")

        self.capacity = capacity
        self.buffer = [None] * self.capacity
        self.head = 0
        self.tail = 0
        self.size = 0

    def write(self, value: int) -> None:
        """
        Writes an integer value to the buffer.

        If the buffer is full, this operation overwrites the oldest value.

        Args:
            value: The integer value to write into the buffer.
        """
        self.buffer[self.tail] = value
        self.tail = (self.tail + 1) % self.capacity

        if self.size == self.capacity:
            # When full, a write operation overwrites the oldest element (at the head).
            # Therefore, the new head becomes the next element in the sequence.
            self.head = (self.head + 1) % self.capacity
        else:
            # If not full, the number of elements simply increases.
            self.size += 1

    def read(self) -> int | None:
        """
        Reads and removes the oldest element from the buffer.

        Each element can be read only once. After being read, its slot in the
        internal buffer is marked as empty (set to None).

        Returns:
            The oldest integer value in the buffer, or None if the buffer is empty.
        """
        if self.size == 0:
            return None

        value = self.buffer[self.head]
        # Invalidate the entry after reading to make debugging clearer.
        self.buffer[self.head] = None
        self.head = (self.head + 1) % self.capacity
        self.size -= 1
        return value

    @property
    def is_empty(self) -> bool:
        """Returns True if the buffer is empty, False otherwise."""
        return self.size == 0

    @property
    def is_full(self) -> bool:
        """Returns True if the buffer is full, False otherwise."""
        return self.size == self.capacity

    def __str__(self) -> str:
        """Provides a developer-friendly string representation of the buffer's state."""
        items = ', '.join(map(lambda x: str(x) if x is not None else 'null', self.buffer))
        return (f"RingBuffer(capacity={self.capacity}, size={self.size}, "
                f"head={self.head}, tail={self.tail}, buffer=[{items}])")


