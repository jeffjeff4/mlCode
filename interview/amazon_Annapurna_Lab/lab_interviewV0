import collections
import heapq
from collections import deque
from typing import List, Tuple

class VirusSpreader:
    """
    Simulates the spread of a virus in a room layout using Dijkstra's Algorithm
    to handle variable infection times (weighted edges).

    The room is represented by a 2D grid where seats can be:
    - SICK_NO_MASK ('o'):   Spreads to 'x' in 1 minute.
    - SICK_MASKED ('O'):    Spreads to 'x' in 4 minutes.
    - HEALTHY_NO_MASK ('x'): Can be infected.
    - HEALTHY_MASKED ('m'): Immune, acts as a barrier.
    - EMPTY (' '):          A barrier.
    """

    # --- Constants for seat states ---
    SICK_NO_MASK = 'o'
    SICK_MASKED = 'O'
    HEALTHY_NO_MASK = 'x'
    HEALTHY_MASKED = 'm'
    EMPTY = ' '
    
    # --- Directions for BFS/Dijkstra (Up, Down, Left, Right) ---
    DIRECTIONS = [(-1, 0), (1, 0), (0, -1), (0, 1)]

    def __init__(self, room_layout: List[List[str]]):
        """
        Initializes the simulator with a deep copy of the room layout.
        """
        if not room_layout or not room_layout[0]:
            self.grid = []
            self.rows = 0
            self.cols = 0
        else:
            self.rows = len(room_layout)
            self.cols = len(room_layout[0])
            if not all(len(row) == self.cols for row in room_layout):
                raise ValueError("Grid rows must all be the same length.")
            self.grid = [row[:] for row in room_layout]

    def _is_valid(self, r: int, c: int) -> bool:
        """Helper to check if a coordinate is within the grid bounds."""
        return 0 <= r < self.rows and 0 <= c < self.cols

    def calculate_spread_time(self) -> int:
        """
        Calculates the total time for the virus to infect all reachable
        healthy (no-mask) people using Dijkstra's algorithm.

        Returns:
            int: The number of minutes required to infect the *last*
                 reachable 'x' person.
                 - Returns 0 if there are no 'x' people to infect.
                 - Returns -1 if there are 'x' people but no 'o' or 'O'
                   people to start the spread.
                 - Returns -1 if there are 'x' people who are unreachable.
        """
        if self.rows == 0:
            return 0

        # Priority Queue for Dijkstra's: stores (time_to_infect, row, col)
        # We use a List and the heapq module.
        pq: List[Tuple[int, int, int]] = []
        
        # Grid to store the minimum time to infect each cell
        distances = [[float('inf')] * self.cols for _ in range(self.rows)]
        
        healthy_people_count = 0

        # --- Step 1: Initialize Queue and Count Healthy People ---
        for r in range(self.rows):
            for c in range(self.cols):
                state = self.grid[r][c]
                if state == self.HEALTHY_NO_MASK:
                    healthy_people_count += 1
                elif state == self.SICK_NO_MASK or state == self.SICK_MASKED:
                    # Add all initial virus sources with time 0
                    distances[r][c] = 0
                    heapq.heappush(pq, (0, r, c))

        # --- Step 2: Handle Edge Cases ---
        if healthy_people_count == 0:
            return 0  # No healthy people to infect.
        if not pq:
            return -1 # Healthy people exist, but no infection source.

        # --- Step 3: Run Dijkstra's Algorithm ---
        while pq:
            # Pop the person with the *smallest* infection time
            time, r, c = heapq.heappop(pq)

            # If this is a stale entry (we've already found a faster path
            # to this node), skip it.
            if time > distances[r][c]:
                continue
                
            # Determine the spread cost *from* this person
            current_state = self.grid[r][c]
            
            if current_state == self.SICK_NO_MASK:
                spread_cost = 1
            elif current_state == self.SICK_MASKED:
                spread_cost = 4
            elif current_state == self.HEALTHY_NO_MASK:
                # This person was infected at 'time'. They now spread.
                # *** KEY ASSUMPTION ***:
                # A newly infected person becomes SICK_NO_MASK ('o')
                # and spreads with a cost of 1.
                spread_cost = 1
            else:
                # This is an EMPTY (' '), HEALTHY_MASKED ('m'),
                # or a stale node. It cannot spread.
                continue 

            # Explore all 4 adjacent neighbors
            for dr, dc in self.DIRECTIONS:
                nr, nc = r + dr, c + dc

                # Check if neighbor is valid AND is an infectable person
                if (self._is_valid(nr, nc) and 
                    self.grid[nr][nc] == self.HEALTHY_NO_MASK):
                    
                    new_time = time + spread_cost
                    
                    # If we found a shorter path to infect this neighbor
                    if new_time < distances[nr][nc]:
                        distances[nr][nc] = new_time
                        heapq.heappush(pq, (new_time, nr, nc))

        # --- Step 4: Final Check ---
        # Find the max time it took to infect any healthy person.
        # If any healthy person is still 'inf', they were unreachable.
        max_minutes = 0
        for r in range(self.rows):
            for c in range(self.cols):
                if self.grid[r][c] == self.HEALTHY_NO_MASK:
                    infection_time = distances[r][c]
                    if infection_time == float('inf'):
                        return -1  # An 'x' was unreachable
                    max_minutes = max(max_minutes, infection_time)

        return max_minutes

